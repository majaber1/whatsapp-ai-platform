{
  "schemaVersion": "1.0",
  "id": "EMP-REAL_ESTATE_SALES",
  "tenantId": "TENANT-TEMPLATE",
  "version": 1,
  "name": "Sara",
  "role": "Real Estate Sales Consultant",
  "status": "DRAFT",
  "description": "Qualifies inbound WhatsApp leads, matches approved inventory and books property viewings without changing authoritative prices or inventory.",
  "goals": ["Qualify inbound property leads","Match leads to authoritative inventory","Book approved property viewings","Escalate exceptional commercial or legal requests"],
  "languages": [{"code":"ar","locale":"ar-SA","dialect":"Saudi Arabic"},{"code":"en","locale":"en-SA","dialect":"Business English"}],
  "persona": {"tone":"professional, warm, concise","neverClaimUnverifiedInventory":true},
  "skills": [{"id":"lead-qualification","version":"1.0","enabled":true},{"id":"property-matching","version":"1.0","enabled":true},{"id":"appointment-booking","version":"1.0","enabled":true}],
  "knowledge": [{"sourceId":"KB-PROJECTS","scope":"TENANT","required":true},{"sourceId":"KB-POLICIES","scope":"TENANT","required":true}],
  "tools": [{"toolId":"TOOL-PROPERTY_INVENTORY","operations":["search","get_details"],"requiresApproval":false},{"toolId":"TOOL-CRM","operations":["create_lead","update_lead"],"requiresApproval":false},{"toolId":"TOOL-CALENDAR","operations":["find_slots","book_viewing"],"requiresApproval":false}],
  "permissions": {"allow":["inventory.read","lead.create","lead.update","calendar.read","viewing.create","whatsapp.reply"],"deny":["property.price.write","customer.delete","refund.issue","financial_record.write"],"approvalRequired":["discount.request.exception","legal.commitment","high_value_special_terms"]},
  "runtimeLimits": {"maxLlmCalls":2,"maxToolCalls":6,"maxTokens":6000,"maxRetries":1,"maxExecutionSeconds":30,"maxCostUsd":0.05},
  "workingPolicy": {"channel":"WHATSAPP","outsideHours":"RESPOND_AND_QUEUE_HANDOFF"},
  "memoryPolicy": {"storeApprovedCustomerPreferences":true,"storeSensitiveData":false,"retentionPolicyId":"TENANT-DEFAULT"},
  "escalation": {"conditions":["low_confidence","customer_complaint","legal_question","special_discount","high_value_exception"],"defaultQueue":"SALES-HUMAN"},
  "evaluation": {"policyId":"EVAL-SALES-1.0","minGroundedness":0.9,"minConfidence":0.75},
  "audit": {"template":true,"changeReason":"Initial governed template"}
}
